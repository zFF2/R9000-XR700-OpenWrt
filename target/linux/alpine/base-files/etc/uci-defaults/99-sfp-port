#!/bin/sh

. /lib/functions/system.sh

case "$(board_name)" in
netgear,r9000|netgear,xr700|r9000|xr700)
	;;
*)
	exit 0
	;;
esac

uci -q batch <<'EOF'
delete system.sfp_led
set system.sfp_led='led'
set system.sfp_led.name='SFP'
set system.sfp_led.sysfs='white:sfp'
set system.sfp_led.trigger='netdev'
set system.sfp_led.dev='eth0'
set system.sfp_led.mode='link'
add_list system.sfp_led.mode='tx'
add_list system.sfp_led.mode='rx'
EOF

uci commit system

exit 0
