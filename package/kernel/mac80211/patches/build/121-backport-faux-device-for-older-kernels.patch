--- a/net/wireless/reg.c
+++ b/net/wireless/reg.c
@@ -52,8 +52,33 @@
 #include <linux/slab.h>
 #include <linux/list.h>
 #include <linux/ctype.h>
+#include <linux/version.h>
 #include <linux/nl80211.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
 #include <linux/device/faux.h>
+
+static inline struct device *faux_device_to_dev(struct faux_device *fdev)
+{
+	return &fdev->dev;
+}
+
+static inline struct kobject *faux_device_to_kobj(struct faux_device *fdev)
+{
+	return &fdev->dev.kobj;
+}
+#else
+#include <linux/device.h>
+
+static inline struct faux_device *faux_device_create(const char *name, struct device *parent,
+					     const struct attribute_group **groups)
+{
+	return (struct faux_device *)root_device_register(name);
+}
+
+#define faux_device_destroy(fdev) root_device_unregister((struct device *)(fdev))
+#define faux_device_to_dev(fdev) ((struct device *)(fdev))
+#define faux_device_to_kobj(fdev) (&(((struct device *)(fdev)))->kobj)
+#endif
 #include <linux/verification.h>
 #include <linux/moduleparam.h>
 #include <linux/firmware.h>
